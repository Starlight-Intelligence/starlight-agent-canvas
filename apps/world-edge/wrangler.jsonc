// world-edge: Cloudflare Worker for the World Canvas (issue #63, lane L2).
//
// Nothing here is deployed by this repo's automation. The ids below are
// placeholders; Frank creates the resources and fills them in (see the
// DEPLOY section of README.md). No secrets live in this file:
//   wrangler secret put MCP_SERVICE_TOKENS
//   wrangler secret put MEDIA_SIGNING_KEY
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "world-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  // agents/mcp/server uses AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],

  // Preview on *.workers.dev only. No preview URLs per version upload.
  "workers_dev": true,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [
      // One instance per world; the instance name is the world id.
      { "name": "WorldAgent", "class_name": "WorldAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorldAgent"] }
  ],

  "d1_databases": [
    {
      "binding": "WORLD_INDEX",
      "database_name": "world-index",
      // PLACEHOLDER: replace with the id printed by `wrangler d1 create world-index`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    // PLACEHOLDER bucket name; created with `wrangler r2 bucket create world-media`.
    { "binding": "WORLD_MEDIA", "bucket_name": "world-media" }
  ],

  "vectorize": [
    // PLACEHOLDER index; created with
    // `wrangler vectorize create world-vectors --dimensions=768 --metric=cosine`.
    { "binding": "WORLD_VECTORS", "index_name": "world-vectors" }
  ],

  // Workers AI, for embeddings (@cf/baai/bge-base-en-v1.5).
  "ai": { "binding": "AI" },

  "vars": {
    // PLACEHOLDER: your Access team domain and the application AUD tag.
    "ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  },

  "observability": { "enabled": true }
}
