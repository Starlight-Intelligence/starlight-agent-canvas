{
  "name": "@starlight-agent-canvas/world-agents",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent-side tools for the Starlight world canvas: a typed MCP client for World Graph v1 tools and a canon proposal to draft PR pipeline.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @starlight-agent-canvas/world build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @starlight-agent-canvas/world build && vitest run --dir src"
  },
  "dependencies": {
    "@starlight-agent-canvas/world": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
